# Copy to .env and run `uv run --env-file .env socialscrape` (or export the variables). Every variable is optional,
# and a blank value means the default (except SOCIALSCRAPE_CACHE_PATH). A value that can't be used stops startup with
# a one-line message naming the variable.

# Invite-only dashboard database. Set this to enable owner/member sign-in, invitations, per-member API keys,
# request history, usage, playground and documentation. The first visitor creates the owner account. In production,
# put this file on persistent storage. Existing SOCIALSCRAPE_API_KEYS remain accepted alongside member keys.
SOCIALSCRAPE_PORTAL_PATH=
# Fernet key used to encrypt owner-managed per-platform proxy and cookies.txt settings. Required before saving
# those settings. Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SOCIALSCRAPE_PORTAL_ENCRYPTION_KEY=
# Required only while creating the first owner through /login. Generate a long random value, supply it as a secret,
# then remove it after the owner exists. Without it, nobody can claim a new deployment's owner account.
SOCIALSCRAPE_SETUP_TOKEN=

# Accepted x-api-key values, comma separated (ASCII only). Leave empty to disable auth.
SOCIALSCRAPE_API_KEYS=

# ScrapeCreators fallback: a request that fails here is asked of ScrapeCreators with this key (printable ASCII), and
# its answer returned. It needs SOCIALSCRAPE_API_KEYS or the portal (without either the key is ignored, as anyone could
# spend its credits); an owner's settings on the dashboard's Fallback page take the place of these. FALLBACK lists when:
# unsupported (501s, bad_cursor), errors (500/502/503), restricted (403), not_found (404), or all, or none.
# PLATFORMS: youtube, tiktok, instagram, facebook, google. URL: only for a relay or a test server.
SOCIALSCRAPE_SCRAPECREATORS_API_KEY=
SOCIALSCRAPE_SCRAPECREATORS_FALLBACK=unsupported,errors
SOCIALSCRAPE_SCRAPECREATORS_PLATFORMS=youtube,tiktok,instagram,facebook,google
SOCIALSCRAPE_SCRAPECREATORS_URL=https://api.scrapecreators.com

# SQLite file backing `cache_max_age`; a relative path is relative to the working directory, and missing directories
# are created. Set to an empty value to disable caching.
SOCIALSCRAPE_CACHE_PATH=.cache/socialscrape.sqlite3

# Worker threads for blocking yt-dlp calls (an integer >= 1), and upstream time limits (seconds, > 0). AI
# transcription downloads the audio in one of these workers, then runs the model in a thread of its own. With few
# workers, calls queued behind a timed-out one share its wait and can time out too; they are dropped, not run late.
# This mainly happens when SOCIALSCRAPE_REQUEST_TIMEOUT <= SOCIALSCRAPE_SOCKET_TIMEOUT.
SOCIALSCRAPE_MAX_WORKERS=8
SOCIALSCRAPE_REQUEST_TIMEOUT=180
SOCIALSCRAPE_SOCKET_TIMEOUT=20

# Outbound proxy for every platform request, scheme://[user:pass@]host[:port], e.g. http://user:pass@host:3128 or
# socks5://host:1080. Schemes: http, https, socks4, socks4a, socks5, socks5h (none means http); no port means the
# scheme's default port. With a proxy set, a network failure (a socket timeout included) answers 502 proxy_error.
SOCIALSCRAPE_PROXY=

# Netscape cookies.txt per platform (use a throwaway account), read but never written back. A per-platform file wins
# over the browser option.
SOCIALSCRAPE_COOKIES_YOUTUBE=
SOCIALSCRAPE_COOKIES_TIKTOK=
SOCIALSCRAPE_COOKIES_INSTAGRAM=
SOCIALSCRAPE_COOKIES_FACEBOOK=
SOCIALSCRAPE_COOKIES_GOOGLE=
# Official TikTok APIs that ordinary account cookies do not authorize.
# Research/Commercial Content token needs research.data.basic and/or research.adlib.basic.
SOCIALSCRAPE_TIKTOK_RESEARCH_ACCESS_TOKEN=
# TikTok Shop requires a separately authorized Shop app. The access token alone reports setup incomplete until
# app key, app secret and shop cipher support is configured.
SOCIALSCRAPE_TIKTOK_SHOP_ACCESS_TOKEN=
# Or read cookies from a local browser profile: chrome | firefox | firefox:default-release | safari ...
SOCIALSCRAPE_COOKIES_FROM_BROWSER=

# Local AI transcription fallback: none | faster-whisper | mlx-whisper (case-insensitive). Install the matching extra:
# uv sync --extra whisper / --extra mlx.
SOCIALSCRAPE_TRANSCRIBE=none
# Whisper model: a name (tiny, base, small, medium, large-v3, turbo, large-v3-turbo, distil-large-v3, ...) or a
# Hugging Face repo. mlx-whisper loads the mlx-community conversion of a name and has none of distil-large-v2,
# distil-small.en or distil-large-v3.5. *.en models are English-only, and yue (Cantonese) needs a large-v3 model.
SOCIALSCRAPE_WHISPER_MODEL=small

# Server bind address (an IP address or a host name that resolves), port (1-65535) and log level (DEBUG, INFO,
# WARNING, ... or a number; case-insensitive), which applies to uvicorn's startup lines and access log too.
HOST=127.0.0.1
PORT=8000
SOCIALSCRAPE_LOG_LEVEL=INFO
